---
import { softwareProjects, type Language } from "../data/content";

interface Props {
  language: Language;
}

const { language } = Astro.props;
const isJapanese = language === "ja";
---

<main id="main" class="projects-page page-shell">
  <header class="projects-hero">
    <p class="eyebrow">SOFTWARE / OPEN SOURCE</p>
    <h1>{isJapanese ? "ソフトウェアプロジェクト" : "Software projects"}</h1>
    <p class="lead">
      {
        isJapanese
          ? "スティアン・フロイスタインが開発しているソフトウェアの一部を紹介します。"
          : "A selection of software projects built by Stian Frøystein."
      }
    </p>
  </header>

  <ul class="project-list">
    {
      softwareProjects.map((project) => (
        <li>
          <img
            src={project.logo}
            width="96"
            height="96"
            alt=""
            loading="lazy"
          />
          <div class="project-copy">
            <h2>{project.title}</h2>
            <p>{project.description[language]}</p>
            <a
              class="text-link"
              href={project.url}
              rel="noopener noreferrer"
              target="_blank"
              data-umami-event="project_outbound_click"
              data-umami-event-project={project.title.toLowerCase()}
              data-umami-event-language={language}
            >
              {isJapanese ? "GitHubで見る" : "View on GitHub"}
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</main>
